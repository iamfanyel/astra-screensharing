<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon.

    The monochrome layer is what Android 13 and later reach for when the user
    turns on themed icons: the background is dropped, and this shape is filled
    with a colour taken from their wallpaper. It is the same star, drawn a
    little smaller, because a themed icon is painted on a filled circle and the
    glyph needs room inside it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
