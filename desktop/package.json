{
  "name": "astra-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "Screen and audio sharing",
  "author": "Fanyel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ASTRA_URL=http://localhost:3000 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "release:draft": "electron-builder --publish always -c.publish.releaseType=draft"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "live.astrascreen.desktop",
    "productName": "Astra",
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "picker/**/*",
      "updater.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Astra",
      "uninstallDisplayName": "Astra",
      "artifactName": "Astra-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iamfanyel",
        "repo": "astra-screensharing"
      }
    ],
    "electronLanguages": [
      "en-US",
      "en-GB",
      "pt-BR",
      "pt-PT",
      "es",
      "fr",
      "de",
      "it"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
